# ---------------------------------------------------------------------------
# IMPETUS ADS — variáveis de ambiente
# Copie para `.env.local` e ajuste. Nunca versione `.env.local`.
#
# Os dados de contato já têm o valor real como padrão em `src/data/site.ts`,
# então o site funciona mesmo sem este arquivo. Use estas variáveis para
# sobrescrever por ambiente (homologação apontando para outro número, etc.).
# ---------------------------------------------------------------------------

# URL canônica de produção (sem barra final). Usada em metadata, sitemap e OG.
NEXT_PUBLIC_SITE_URL=https://www.impetusads.com.br

# --- Contato ---------------------------------------------------------------
# WhatsApp comercial no formato internacional, apenas dígitos.
NEXT_PUBLIC_WHATSAPP=5511945189191

# E-mail comercial exibido no site
NEXT_PUBLIC_EMAIL=argolos.impetus01@gmail.com

# Perfis sociais. Deixe em branco para o ícone não ser renderizado.
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/impetus.ad
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_YOUTUBE=

# --- Analytics (opcional: se vazio, o script não é carregado) --------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Formulário comercial --------------------------------------------------
# Destino dos leads. Variável de SERVIDOR — nunca chega ao navegador.
# Sem valor, o lead é apenas registrado no log do servidor.
LEAD_WEBHOOK_URL=
LEAD_NOTIFICATION_EMAIL=
